# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Next.js frontend (Doulitsa) — LOCAL DEV image.
#
# Mirrors how the app runs on a laptop: `next dev` (no production build, no
# build-time TypeScript gate). Used by docker-compose for local development so
# the container behaves exactly like `yarn dev` on the host.
#
# The compose service bind-mounts ./frontend over /app for hot reload and keeps
# the image's node_modules / .next via anonymous volumes, so the deps + Prisma
# client baked in here survive the bind mount.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

# node-gyp toolchain for native deps (bcrypt) + openssl for the Prisma engine
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential python3 openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable

# Install deps first so this layer caches across source-only edits
COPY package.json yarn.lock .yarnrc.yml ./
RUN yarn install --immutable

# App sources (node_modules/.next excluded via .dockerignore)
COPY . .

EXPOSE 3000
# next dev --turbo, bound to all interfaces so the host port mapping works
CMD ["yarn", "dev", "-p", "3000", "-H", "0.0.0.0"]
