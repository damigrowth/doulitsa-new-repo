# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Athens

# Database — match the existing Next.js Postgres
DATABASE_URL=postgres://USER:PASS@HOST:5432/DB
DIRECT_URL=postgres://USER:PASS@HOST:5432/DB

# Redis (cache + Celery broker + Channels layer)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CHANNELS_REDIS_URL=redis://localhost:6379/3

# CORS — Next.js frontend origin
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-next-domain.example
FRONTEND_BASE_URL=http://localhost:3000

# JWT
SIMPLE_JWT_ACCESS_LIFETIME_MINUTES=15
SIMPLE_JWT_REFRESH_LIFETIME_DAYS=14
SIMPLE_JWT_SIGNING_KEY=

# Google OAuth (django-allauth)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Brevo (email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@example.com
BREVO_LIST_USERS=
BREVO_LIST_EMPTY_PROFILE=
BREVO_LIST_NO_SERVICES=
BREVO_LIST_ACTIVE_PROS=

# Worldline / Cardlink
WORLDLINE_MERCHANT_ID=
WORLDLINE_SHARED_SECRET=
# Test/live credential pairs (OLD worldline-config.ts) — PAYMENTS_TEST_MODE picks
# the pair; falls back to WORLDLINE_MERCHANT_ID/WORLDLINE_SHARED_SECRET if empty.
WORLDLINE_TEST_MID=
WORLDLINE_TEST_SHARED_SECRET=
WORLDLINE_LIVE_MID=
WORLDLINE_LIVE_SHARED_SECRET=
WORLDLINE_BASE_URL=https://www.cardlink.gr/sandbox/uiform
WORLDLINE_API_URL=https://www.cardlink.gr/sandbox/uiform
WORLDLINE_RETURN_URL=
WORLDLINE_CANCEL_URL=
WORLDLINE_WEBHOOK_SECRET=

# Stripe (legacy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTH=
STRIPE_PRICE_ID_YEAR=

# PayPal (legacy)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# AADE SOAP (Greek tax registry — for AFM lookup)
AADE_USERNAME=
AADE_PASSWORD=

# reCAPTCHA (contact form)
RECAPTCHA_SECRET_KEY=

# Internal secrets
CRON_SECRET=                       # shared secret protecting Celery beat HTTP triggers
ADMIN_API_KEY=                     # static admin API key for ops (also see DB-stored keys)
INTERNAL_PROXY_SECRET=             # must match the frontend's — trusts X-Real-Client-IP on SSR calls
ADMIN_EMAIL=                       # admin notification inbox (reviews/verifications/contact/reports)
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=               # shown by /api/auth/maintenance when MAINTENANCE_MODE=true

# Feature gates
PAYMENTS_ENABLED=true
PAYMENTS_TEST_MODE=true
